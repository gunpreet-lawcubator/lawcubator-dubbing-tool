# Copy this file to .env and fill in your real keys. .env is gitignored.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional login password for the app. Leave empty for no login screen (local dev).
# Generate the value with:  python3 -c "import auth; print(auth.hash_password('your-password'))"
APP_PASSWORD_HASH=

# Languages + their ElevenLabs voice IDs are managed from the app's Voice
# settings panel (stored in backend/voices.json), not here.
